# Copy this file to .env (it is ignored by git) and fill in your real details, then run npm run build.
VITE_CONTACT_EMAIL=
# Optional: shown on the Contact page only if you fill it in.
VITE_CONTACT_PHONE=
# Optional: a form endpoint that accepts a JSON POST and replies 200 when it saves the message.
VITE_FEEDBACK_ENDPOINT=
# Optional: the public address of the site (adds the share-preview image and canonical link).
VITE_SITE_URL=
